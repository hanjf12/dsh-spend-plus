{
  "name": "dsh-spend-plus",
  "version": "0.1.0",
  "description": "dsh-spend + DeepSeek account balance: usage/cost dashboard (peak/off-peak aware) plus the official CNY balance readout",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./balance": {
      "default": "./lib/balance.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./stats": {
      "default": "./lib/stats.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "token",
    "usage",
    "billing",
    "cost",
    "spend",
    "balance",
    "monitoring",
    "plugin"
  ],
  "license": "MIT",
  "author": "hanjf12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanjf12/dsh-spend-plus.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
